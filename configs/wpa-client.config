CONFIG_DRIVER_NL80211=y
CONFIG_DRIVER_WEXT=y
CONFIG_LIBNL_TINY=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=internal
CONFIG_CRYPTO=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_NO_CONFIG_WRITE=y
CONFIG_NO_WPA_PASSPHRASE=y
CONFIG_IEEE80211W=y
CFLAGS += -Os -ffunction-sections -fdata-sections -I@ROOT@/downloads/libnl-tiny/include
LDFLAGS += -static -Wl,--gc-sections @ROOT@/build/arm/arm_legacy_stat.o -L@ROOT@/build/libnl-tiny
