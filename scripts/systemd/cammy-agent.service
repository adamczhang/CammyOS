[Unit]
Description=Cammy supported agent control service (idle by default)
After=network.target
ConditionPathIsMountPoint=@MOUNT@

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/private/agent-control/venv/bin/python @ROOT@/host/cammy_agent_service.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077

[Install]
WantedBy=default.target
