          },
          "409": {
            "description": "Control lease conflict"
          },
          "501": {
            "description": "Adapter not implemented/enabled"
          },
          "503": {
            "description": "Backend unavailable"
          }
        }
      }
    },
    "/v1/audio/capture": {
      "post": {
        "summary": "Reserved microphone adapter; currently501.",
        "operationId": "v1_audio_capture",
        "parameters": [
          {
            "name": "X-Agent-ID",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
