          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid bearer credential"
          },
          "409": {
            "description": "Control lease conflict"
          },
          "501": {
            "description": "Adapter not implemented/enabled"
          },
          "503": {
            "description": "Backend unavailable"
          }
        }
      }
    },
    "/v1/speak": {
      "post": {
        "summary": "Reserved speaker adapter; currently501.",
        "operationId": "v1_speak",
        "parameters": [
          {
            "name": "X-Agent-ID",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Adapter not implemented; no actuation occurs."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
