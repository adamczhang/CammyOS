          },
          "409": {
            "description": "Control lease conflict"
          },
          "501": {
            "description": "Adapter not implemented/enabled"
          },
          "503": {
            "description": "Backend unavailable"
          }
        }
      }
    },
    "/v1/probes": {
      "get": {
        "summary": "Catalogue of fixed read-only metadata collectors and supervisor availability.",
        "operationId": "v1_probes_catalogue",
        "responses": {
          "200": {
            "description": "Catalogue; no collection starts"
          }
        }
      },
      "post": {
        "summary": "Start one serialized metadata job; no control lease or sensing.",
        "operationId": "v1_probes_start",
        "parameters": [
          {
            "name": "X-Agent-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,48}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "probe"
                ],
                "properties": {
                  "probe": {
                    "type": "string",
                    "enum": [
                      "runtime",
                      "network-bindings",
                      "display-layout",
                      "audio-state"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted; poll job_id"
          },
          "400": {
            "description": "Unknown probe or invalid arguments"
          },
          "409": {
            "description": "Worker busy or awaiting reap"
          },
          "503": {
            "description": "Worker unavailable"
          }
        }
      }
    },
    "/v1/probes/{job_id}": {
      "get": {
        "summary": "Read one of the two retained jobs; result may contain missing or truncated sources.",
        "operationId": "v1_probes_status",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^job-[1-9][0-9]{0,19}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "running/completed/failed/timed_out/cancelled with monotonic timing"
          },
          "404": {
            "description": "Unknown or evicted job"
          }
        }
      }
    },
    "/v1/probes/{job_id}/cancel": {
      "post": {
        "summary": "Cancel the matching job owner's work. Labels are cooperative, not separate credentials.",
        "operationId": "v1_probes_cancel",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^job-[1-9][0-9]{0,19}$"
            }
          },
          {
            "name": "X-Agent-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Terminal job status; already finished jobs unchanged"
          },
          "409": {
            "description": "Job owner required"
          },
          "404": {
            "description": "Unknown or evicted job"
          }
        }
      }
    }
  }
}
