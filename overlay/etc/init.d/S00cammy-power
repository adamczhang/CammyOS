#!/bin/sh
# SPDX-License-Identifier: MIT
# Apply before S01app loads its settings. The running app saves its cached
# settings at shutdown, so changes made directly to the file can be lost.
FILE=/data/setting.lua

quiet_start() {
  key='^[[:blank:]]*\["ml_startup_volume"\][[:blank:]]*=[[:blank:]]*'
  [ -f "$FILE" ] && [ ! -L "$FILE" ] || return 1
  [ "$(grep -c "$key" "$FILE")" = 1 ] || return 1
  if grep -q "${key}0[[:blank:]]*," "$FILE"; then
   return 0
  fi
  grep -q "${key}1[[:blank:]]*," "$FILE" || return 1
  sed -i "s/\($key\)1\([[:blank:]]*,\)/\10\2/" "$FILE"
}

case "$1" in
 start|boot)
  if [ -f /etc/cammy/quiet-start.enabled ]; then
   quiet_start || echo 'Cammy: could not turn off Startup Music' >&2
  fi
  [ -f /etc/cammy/desk.enabled ] || exit 0
  [ -f "$FILE" ] || exit 1
  [ "$(grep -c ml_camera_timedshutdown "$FILE")" = 1 ] || exit 1
  if grep ml_camera_timedshutdown "$FILE" | grep '=[[:space:]]*0[[:space:]]*,' >/dev/null; then
   exit 0
  fi
  grep ml_camera_timedshutdown "$FILE" | grep '=[[:space:]]*[1-3][[:space:]]*,' >/dev/null || exit 1
  sed -i 's/\(ml_camera_timedshutdown[^=]*=[[:space:]]*\)[1-3]/\10/' "$FILE" || exit 1
  ;;
 *) echo 'Usage: S00cammy-power start' ;;
esac
